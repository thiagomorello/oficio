# Oficio: environment variables. Copy to .env and adjust. Full reference: docs/configuration.md
# Everything left empty here is optional; the server logs what is missing at boot.
# Generate all secrets at once with: ./scripts/gen-secrets.sh  (PowerShell: ./scripts/gen-secrets.ps1)

# ---------------------------------------------------------------- HTTP server

# Port the app listens on (default 4747).
OFFICE_PORT=4747
# Bind address. Default: 0.0.0.0 inside Docker (OFFICE_IN_DOCKER=1), otherwise 127.0.0.1.
# OFFICE_HOST=127.0.0.1
# Set to 1 when running in a container (the Docker image already sets it).
# OFFICE_IN_DOCKER=1
# Development mode (Vite middleware, HMR, in-memory DB when DATABASE_URL is empty). Same as `--dev`. Never in production.
# OFFICE_DEV=1
# Demo mode: no database, data lost on restart, user dev@oficio.local / dev12345. For trying Oficio out, never in production.
# OFFICE_IN_MEMORY=1
# Public URL of the app, used in e-mail links (password reset, invites).
# With docker-compose.yml leave it empty: it defaults to https://$OFFICE_DOMAIN.
OFFICE_PUBLIC_URL=
# Host names accepted by the Host/Origin guard (comma-separated). localhost and IPs are always accepted.
# With docker-compose.yml leave it empty: it defaults to $OFFICE_DOMAIN.
OFFICE_ALLOWED_HOSTS=
# 1 when behind a reverse proxy (Caddy, Traefik, nginx): trusts X-Forwarded-For for rate limiting.
TRUST_PROXY=1

# ---------------------------------------------------------------- branding (whitelabel)

# App name: page titles, e-mails, PWA manifest (max 40 chars).
OFFICE_APP_NAME=Oficio
# Logo shown in the top bar, login and admin pages. Absolute URL or a path served by the app.
# OFFICE_LOGO_URL=/assets/brand/logo.svg
# Accent color (#rrggbb): buttons, highlights, the in-world sign and e-mail header.
# OFFICE_ACCENT_COLOR=#7c9cff
# Text on the reception sign in the map (max 14 chars, uppercase pixel font). Default: OFFICE_APP_NAME.
# OFFICE_SIGN_TEXT=Oficio
# Default UI language for new visitors, server messages and e-mails: en | pt-BR | es. Users can switch in the UI.
OFFICE_DEFAULT_LOCALE=en

# ---------------------------------------------------------------- session and login

# JWT session secret (HS256). Required in production; generate with: openssl rand -hex 32
OFFICE_JWT_SECRET=
# Session cookie only over HTTPS. Default 1. Set 0 only for local development over plain HTTP.
OFFICE_COOKIE_SECURE=1
# Master password that logs into any account. Development only (ignored outside --dev). Empty = disabled.
LOGIN_MASTER_PASSWORD=

# ---------------------------------------------------------------- MySQL database

# Full MySQL 8 URL. Required outside --dev (without it, dev mode uses in-memory repositories).
# With docker-compose.yml the host is the `mysql` service. Use URL-encoding for special characters in the password.
DATABASE_URL=mysql://oficio:change-me@mysql:3306/oficio
# ...or the parts, used only when DATABASE_URL is empty.
# MYSQL_HOST=mysql
# MYSQL_PORT=3306
# MYSQL_USER=oficio
# MYSQL_PASSWORD=
# MYSQL_DATABASE=oficio
# TLS to a managed database: required | skip-verify (or append ?ssl=true to DATABASE_URL).
# MYSQL_SSL=
# Path to a PEM bundle with the CA that signed the database certificate (private/corporate CA). Implies TLS with validation.
# With docker-compose.yml mount the file into the app container, e.g. ./certs/mysql-ca.pem:/certs/mysql-ca.pem:ro
# MYSQL_SSL_CA=

# Used by docker-compose.yml to create the database container (first boot only).
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=oficio
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=oficio

# ---------------------------------------------------------------- LiveKit (audio and video)

# Public LiveKit URL used by browsers (wss://...). With docker-compose.yml leave it empty: defaults to wss://$LIVEKIT_DOMAIN.
# LiveKit Cloud: wss://<project>.livekit.cloud
LIVEKIT_URL=
# Internal URL the server uses for the LiveKit API (room control). With docker-compose.yml leave it empty
# (defaults to http://livekit:7880). LiveKit Cloud: the same wss:// URL as LIVEKIT_URL.
LIVEKIT_INTERNAL_URL=
# API key and secret (the same pair configured in the LiveKit server). Generate: key = API + openssl rand -hex 6, secret = openssl rand -hex 24
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Name of the single LiveKit room used by the office.
LIVEKIT_ROOM=oficio

# Only for docker-compose.yml (self-hosted LiveKit): public IP of the host and media ports.
LIVEKIT_NODE_IP=
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882

# ---------------------------------------------------------------- domains (docker-compose.yml with Caddy)

OFFICE_DOMAIN=office.example.com
LIVEKIT_DOMAIN=livekit.example.com
# E-mail for Let's Encrypt expiry notices (Caddy).
ACME_EMAIL=admin@example.com

# ---------------------------------------------------------------- e-mail (optional)

# SendGrid API key for invite / password-reset e-mails. Without it, temporary passwords are shown to the admin on screen.
SENDGRID_API_KEY=
# Sender address (required when SENDGRID_API_KEY is set).
MAIL_FROM=

# ---------------------------------------------------------------- observability (optional)

# Protects GET /metrics (Prometheus). Empty = public (aggregate counters only). Generate: openssl rand -hex 24
METRICS_TOKEN=

# ---------------------------------------------------------------- local development

# Vite dev server port for `npm run dev:client` (default 5173); it proxies /api and /ws to OFFICE_PORT.
# VITE_PORT=5173
